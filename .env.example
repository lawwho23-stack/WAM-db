# Copy to .env.local and fill in
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Owner sign-in ---------------------------------------------------------
# The only email that may sign in.
OWNER_EMAIL=owner@example.com
# A scrypt hash of the passphrase — generate with: node scripts/owner-password.mjs
OWNER_PASSWORD_HASH=
# Fallback if you would rather keep the plaintext: OWNER_PASSWORD=
# Signs the session cookie. 32+ characters: openssl rand -base64 48
SESSION_SECRET=

# --- Models ----------------------------------------------------------------
# OpenRouter (for embeddings + review models)
OPENROUTER_API_KEY=
EMBED_MODEL=perplexity/pplx-embed-v1-0.6b
DECISION_MODEL=z-ai/glm-5.3-flash
REVIEWER_MODEL=deepseek/deepseek-v4-flash-0731

# --- Storage ---------------------------------------------------------------
# Upstash Redis (optional — app falls back to in-memory session notes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Jobs ------------------------------------------------------------------
# Guards /api/cron. Vercel Cron sends it automatically once it is set.
CRON_SECRET=

# --- GitHub review loop (later step) ---------------------------------------
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
